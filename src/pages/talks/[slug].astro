---
import { fetchAllTalks, fetchTalkById } from "../../services/talks";

import TalksLayout from "../../components/TalksLayout";
const { slug } = Astro.params;
const talks = await fetchAllTalks();
 export const prerender = false
const page = talks?.find((page) => page.slug === slug)!;

const { videoId, title } = page;
const response = await fetchTalkById(videoId ?? "");
const talkData = response?.[0];
---


  <div class="event_mainWrapper">
    <TalksLayout client:only="react" talk={talkData} videoId={videoId} />

  </div>

