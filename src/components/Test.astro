<div id="recipes-container" class="recipes-container">
    <p>Loading recipes...</p>
  </div>
  
  <script>
    async function fetchRecipes() {
      const response = await fetch("https://dummyjson.com/recipes"); // Update with your actual API
      const data = await response.json();
      const recipes = data.recipes || [];
  
      const container = document.getElementById("recipes-container");
      container.innerHTML = recipes
        .map(
          (recipe) => `
          <div class="recipe-card">
            <img src="${recipe.image}" alt="${recipe.title}" />
            <h2>${recipe.name}</h2>
            <p>${recipe.cuisine}</p>
          </div>
        `
        )
        .join("");
    }
  
    fetchRecipes();
  </script>
  
  <style>
      .recipe-card {
      border: 1px solid #ddd;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
      padding: 16px;
      background: white;
      text-align: center;
    }
    .recipes-container {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 16px;
      padding: 20px;
    }
  
    .recipe-card img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 8px;
    }
    .recipe-card h2 {
      font-size: 1.5rem;
      margin: 12px 0;
    }
    .recipe-card p {
      font-size: 1rem;
      color: #555;
    }
  </style>
  